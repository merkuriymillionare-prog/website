# Скопируй этот файл в `.env.local` (рядом с package.json) и раскомментируй нужные строки.
# `.env.local` в репозиторий не попадает (он в .gitignore) — пароли и токены храним только там
# и в настройках хостинга (Vercel → Settings → Environment Variables).

# ===== Админка (/admin) =====
# Пароль для входа (минимум 8 символов, лучше длинная фраза). Пока строка закомментирована — админка выключена.
ADMIN_PASSWORD='1q2q3q4q5q6q7q8q9q10qSEXwork'

# Необязательно: отдельный секрет для подписи входа (если не задан, берётся от пароля)
# ADMIN_SECRET=

# ===== Куда сохранять сборки и картинки =====
# Локально (npm run dev) и на своём сервере ничего не нужно: данные пишутся в папку data/ проекта.
#
# Vercel: сохранять в репозиторий GitHub (иначе админка работает только на просмотр).
# 1) GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens → Generate new token
#    Repository access: Only select repositories → твой репозиторий сайта
#    Permissions → Repository permissions → Contents: Read and write
# 2) Раскомментируй и заполни (только в настройках Vercel, не в файлах проекта!):
GITHUB_TOKEN=
GITHUB_REPO=логин/название-репозитория
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data

# Своя папка для данных (если нужно):
# DATA_DIR=C:\sites\nelacostework\data
